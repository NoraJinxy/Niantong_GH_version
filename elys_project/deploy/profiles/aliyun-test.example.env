# ELYS two-server deployment profile example.
# Copy this file to aliyun-test.env locally and fill in non-secret deployment values.
# Keep AccessKey, passwords, SSH private keys, and root passwords outside the repository.

DEPLOY_PROFILE=aliyun-test
DEPLOY_TARGET=remote

ACTIVE_SET=setA

SETA_ENTRY_SERVER_IP=REPLACE_WITH_ENTRY_SERVER_IP
SETA_COMPUTE_SERVER_IP=REPLACE_WITH_COMPUTE_SERVER_IP
SETA_OSS_BUCKET=REPLACE_WITH_OSS_BUCKET

SETB_ENTRY_SERVER_IP=REPLACE_WITH_ENTRY_SERVER_IP
SETB_COMPUTE_SERVER_IP=REPLACE_WITH_COMPUTE_SERVER_IP
SETB_OSS_BUCKET=REPLACE_WITH_OSS_BUCKET

OSS_REGION=cn-shenzhen

ACCESS_MODE=ip
PUBLIC_SCHEME=http
SERVER_USER=root
SSH_PORT=22

STUDIES_DIR=/mnt/elys_data/studies
EXTRA_APT_PACKAGES=
USE_CN_MIRRORS=true

KEEP_EXISTING_DATA=false
RESET_DB=true
RESET_STORAGE=true
RESET_DATA_ROOT=true
