# ELYS Aliyun deployment profile example.
# Copy to aliyun-test.env locally and fill real hosts/buckets outside git.

DEPLOY_PROFILE=aliyun-test
DEPLOY_TARGET=remote

ACTIVE_SET=setA

SETA_ENTRY_SERVER_IP=REPLACE_WITH_SETA_ENTRY_PUBLIC_IP
SETA_COMPUTE_SERVER_IP=REPLACE_WITH_SETA_COMPUTE_PUBLIC_IP
SETA_OSS_BUCKET=REPLACE_WITH_SETA_OSS_BUCKET

SETB_ENTRY_SERVER_IP=REPLACE_WITH_SETB_ENTRY_PUBLIC_IP
SETB_COMPUTE_SERVER_IP=REPLACE_WITH_SETB_COMPUTE_PUBLIC_IP
SETB_OSS_BUCKET=REPLACE_WITH_SETB_OSS_BUCKET

OSS_REGION=cn-shenzhen

# ENTRY_DOMAIN=elysbrain.site
# DATA_DOMAIN=data.elysbrain.site

ACCESS_MODE=ip
PUBLIC_SCHEME=http
SERVER_USER=root
SSH_PORT=22

STUDIES_DIR=/mnt/elys_data/studies
# DATA_UPSTREAM=http://REPLACE_WITH_COMPUTE_PRIVATE_IP
EXTRA_APT_PACKAGES=

USE_CN_MIRRORS=true

KEEP_EXISTING_DATA=false
RESET_DB=true
RESET_STORAGE=true
RESET_DATA_ROOT=true
