# ELYS two-Aliyun-server test profile.
# This profile is intentionally reset-friendly for demo/test cycles.
# Purpose: Aliyun test deployment profile for entry/compute hosts and public access settings.
# Related: deploy/deploy_remote.ps1, deploy/deploy.sh, docs_v2/2-10 deployment architecture.
# NOTE: keep this file ASCII-only. PowerShell 5.1 Get-Content/WriteAllLines round-trips
#       (buy_ecs/release_ecs rewrite COMPUTE_SERVER_IP) mojibake any non-ASCII comments.

DEPLOY_PROFILE=aliyun-test
DEPLOY_TARGET=remote



# === Deployment resource set =====================================================================
# Switch the WHOLE deployment (entry server + compute server + OSS bucket) by editing ONE line below:
#   ACTIVE_SET=setA  or  setB     (no more comment toggling). All scripts (s1 buy / s2 deploy /
#   s3 test / s4 release / OSS clear+enable) resolve ${ACTIVE_SET}_* into the flat
#   ENTRY_SERVER_IP / COMPUTE_SERVER_IP / OSS_BUCKET they read.
#   Leave ACTIVE_SET empty -> fall back to flat ENTRY_SERVER_IP/COMPUTE_SERVER_IP/OSS_BUCKET (legacy).
#   COMPUTE_SERVER_IP is ephemeral: s1 buy_ecs writes it into the ACTIVE set; s4 release clears it.
#   OSS AccessKey is NOT here -- put it in ~/.elys/oss.env (one RAM key covers all buckets).
ACTIVE_SET=setA

# ---- set A(HuangGan) ----
SETA_ENTRY_SERVER_IP=8.135.40.150
SETA_COMPUTE_SERVER_IP=120.76.158.42
SETA_OSS_BUCKET=elys-oss-test1

# ---- set B(JinXingyi) ----
SETB_ENTRY_SERVER_IP=47.119.178.132
SETB_COMPUTE_SERVER_IP=47.115.52.212
SETB_OSS_BUCKET=elys-oss-test2

# OSS region (shared by both sets); endpoints derive oss-<region>-internal (compute) / oss-<region> (local).
OSS_REGION=cn-shenzhen

# ENTRY_DOMAIN=elysbrain.site
# DATA_DOMAIN=data.elysbrain.site

ACCESS_MODE=ip
PUBLIC_SCHEME=http
SERVER_USER=root
SSH_PORT=22

STUDIES_DIR=/mnt/elys_data/studies
# DATA_UPSTREAM: leave unset to auto-use http://${COMPUTE_SERVER_IP} (follows the compute IP above).
# Only override with -DataUpstream http://<private-ip> when the entry host must reach the compute
# host over the internal VPC.
#
# BANDWIDTH SAVER (recommended): point the entry->compute API proxy at the COMPUTE server's PRIVATE
# (VPC intranet) IP, so that internal hop runs over the free fast internal network instead of
# eating public bandwidth on both boxes. Prerequisite: entry and compute are in the SAME VPC.
# Find the private IP in Aliyun console (compute ECS -> intranet/private IP, usually 172.x / 10.x).
# Then fill it in and uncomment the next line (keep this file ASCII-only):
# DATA_UPSTREAM=http://REPLACE_WITH_COMPUTE_PRIVATE_IP
# EXTRA_APT_PACKAGES: extra system apt packages (space-separated), auto-installed at deploy time to
# patch dependencies without editing deploy.sh. e.g. EXTRA_APT_PACKAGES="ffmpeg libsndfile1 unzip"
EXTRA_APT_PACKAGES=

# WORKER tuning (compute server). Leave commented to keep deploy.sh defaults: concurrency=2,
# MemoryHigh=9G, MemoryMax=10G (sized for an 8C16G box that also hosts PostgreSQL/Redis).
# The 8 cores are mostly idle at concurrency=2; raising it shortens batch wall-clock near-linearly.
# MEASURE RSS FIRST before raising: run one 64-channel ERP/PSD and watch the worker cgroup peak RSS
#   ( systemctl status elys-worker  OR  cat /sys/fs/cgroup/system.slice/elys-worker.service/memory.peak ).
# Rule: concurrency * single-task-peak-RSS < MemoryMax, and leave ~6G for PostgreSQL on the same box.
# When you bump concurrency, raise MemoryHigh/Max together or you will hit the 10G guardrail and OOM.
# WORKER_CONCURRENCY=3
# WORKER_MEMORY_HIGH=11G
# WORKER_MEMORY_MAX=12G

# USE_CN_MIRRORS: route PostgreSQL/pip/npm/Node through China mirrors (PG/Node fall back to official
# sources on failure). Keep true for Aliyun China hosts; set false for overseas hosts.
USE_CN_MIRRORS=true

KEEP_EXISTING_DATA=false
RESET_DB=true
RESET_STORAGE=true
RESET_DATA_ROOT=true
