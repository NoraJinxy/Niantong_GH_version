# ELYS two-Aliyun-server test profile.
# This profile is intentionally reset-friendly for demo/test cycles.
# Purpose: Aliyun test deployment profile for entry/compute hosts and public access settings.
# Related: deploy/deploy_remote.ps1, deploy/deploy.sh, docs_v2/2-10 deployment architecture.

DEPLOY_PROFILE=aliyun-test
DEPLOY_TARGET=remote

ENTRY_SERVER_IP=8.135.40.150
# ── 计算服务器 IP ── 切换计算服只需改这一行（单一数据源，DATA_UPSTREAM 会自动跟随）
#   当前在用: 47.115.42.144   ·   备用旧机: 8.135.57.42
#   只想临时切一次、不改文件： .\deploy_remote.cmd -ComputeServerIP 8.135.57.42
COMPUTE_SERVER_IP=112.74.106.217
ENTRY_DOMAIN=elysbrain.site
DATA_DOMAIN=data.elysbrain.site

ACCESS_MODE=ip
PUBLIC_SCHEME=http
SERVER_USER=root
SSH_PORT=22

STUDIES_DIR=/mnt/elys_data/studies
# DATA_UPSTREAM 不写则自动取 http://${COMPUTE_SERVER_IP}（跟随上面的计算服 IP）。
# 仅当入口服需走内网/VPC 访问计算服时，才用 -DataUpstream http://<内网IP> 覆盖。

# 额外系统 apt 包（空格分隔）：部署时若缺失会自动安装，用于临时补依赖而无需改 deploy.sh。
# 例：EXTRA_APT_PACKAGES="ffmpeg libsndfile1 unzip"
EXTRA_APT_PACKAGES=

# 国内镜像加速(PostgreSQL/pip/npm/Node 走国内镜像, PG/Node 失败自动回退官方源)。
# 阿里云国内服务器保持 true; 海外服务器改 false 走官方源。
USE_CN_MIRRORS=true

KEEP_EXISTING_DATA=false
RESET_DB=true
RESET_STORAGE=true
RESET_DATA_ROOT=true
