{
  "schema_version": "2.0",
  "type": "eeg/group/merge",
  "title": "Group Merge",
  "category": "group",
  "phase": "phase2",
  "description": "把多个 ERP / PSD / TFR / unit_stack 结果沿 unit 轴合并成组级 unit_stack。节点始终识别 condition 语义，并按 condition 自动分组输出一个或多个 unit_stack。",
  "tags": ["group", "merge", "stack", "condition", "grand-average", "erp", "psd", "tfr"],
  "inputs": [
    {
      "name": "input",
      "type": "stackable",
      "label": "Result",
      "required": true,
      "cardinality": "one_or_many"
    }
  ],
  "outputs": [
    {
      "name": "output",
      "type": "unit_stack",
      "label": "Unit Stack",
      "cardinality": "one_or_many"
    }
  ],
  "properties": [
    {
      "name": "group_label",
      "label": "组标签",
      "type": "string",
      "default": "",
      "required": false,
      "description": "可选。仅用于结果命名和审计；condition 分组由后端自动完成。"
    }
  ],
  "backend": {
    "module": "app.engine.group.merge",
    "function": "run_group_merge",
    "save_descriptor": "unit_stack",
    "output_kind": "npz",
    "supports_batch": false,
    "interactive": false
  },
  "save": {
    "step_label": "unit_stack",
    "name_template_default": "Unit Stack",
    "always_per_condition": true,
    "auto_tags": ["step:group_merge", "type:unit_stack"],
    "data_type": "unit_stack"
  },
  "compute_cost": "cheap",
  "output_footprint": "medium",
  "ui": {"color": "#7C3AED", "default_size": [220, 112], "preview_type": "unit_stack"}
}
