{
  "schema_version": "2.0",
  "type": "eeg/group/merge",
  "title": "Group Merge",
  "category": "group",
  "phase": "phase2",
  "description": "把多个分析产物沿「unit 轴」堆叠成组级张量 unit_stack（n_units × n_channels × …）。通吃 ERP / PSD / TFR：一个 unit 可以是被试、run 或试次（语义由你定）。要求同形态、通道可取交集、时间/频率轴一致。典型用法：接在 ERP/PSD/TFR 节点后，自动收集同一批次所有被试的结果，供 Grand Average / Compare 使用。",
  "tags": ["group", "merge", "stack", "grand-average", "erp", "psd", "tfr"],
  "inputs": [
    {
      "name": "input",
      "type": "stackable",
      "label": "可堆叠产物（ERP / PSD / TFR · 多被试）",
      "required": true,
      "cardinality": "one_or_many"
    }
  ],
  "outputs": [
    {
      "name": "output",
      "type": "unit_stack",
      "label": "Unit Stack",
      "cardinality": "one"
    }
  ],
  "properties": [
    {
      "name": "unit_label",
      "label": "一个 unit 代表",
      "type": "select",
      "default": "subject",
      "required": false,
      "options": [
        {"value": "subject", "label": "被试"},
        {"value": "run", "label": "run / 次"},
        {"value": "trial", "label": "试次"},
        {"value": "session", "label": "session"}
      ],
      "description": "本次堆叠里「一个 unit」的语义（仅作标注，不影响数学）。跨被试 grand average 选「被试」。"
    },
    {
      "name": "label",
      "label": "Group 标签",
      "type": "string",
      "default": "",
      "required": false,
      "description": "用于区分不同条件的组（如 \"EO\"、\"EC\"）；会写入产物文件名与 preview。"
    }
  ],
  "backend": {
    "module": "app.engine.group.merge",
    "function": "run_group_merge",
    "save_descriptor": "unit_stack",
    "output_kind": "npz",
    "supports_batch": false,
    "interactive": false
  },
  "save": {
    "step_label": "unit_stack",
    "name_template_default": "Unit Stack",
    "auto_tags": ["step:group_merge", "type:unit_stack"],
    "data_type": "unit_stack"
  },
  "compute_cost": "cheap",
  "output_footprint": "medium",
  "ui": {"color": "#7C3AED", "default_size": [200, 110], "preview_type": "unit_stack"}
}
