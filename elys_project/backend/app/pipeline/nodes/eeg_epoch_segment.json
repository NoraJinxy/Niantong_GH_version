{
  "schema_version": "2.0",
  "type": "eeg/epoch/segment",
  "title": "Epoch",
  "category": "epoch",
  "phase": "phase1",
  "description": "按事件切分 Epochs；输入为 Epoch Merge 结果时，可用子事件名匹配父/子完整路径事件。",
  "tags": ["epoch", "events", "erp"],
  "inputs": [
    {"name": "input", "type": "epoch_source", "label": "EEG / Epochs", "required": true, "cardinality": "one_or_many"}
  ],
  "outputs": [
    {"name": "output", "type": "epochs", "label": "Epochs", "cardinality": "same_as_input"}
  ],
  "properties": [
    {"name": "conditions", "label": "条件（勾选要切分的事件分组）", "type": "event_select", "default": "", "required": true, "description": "从上游自动识别的事件分组里勾选；上游为 Epoch Merge 时可只勾选子事件，运行时自动展开为父/子完整路径。"},
    {"name": "tmin", "label": "时窗起点", "type": "number", "unit": "s", "default": -0.2},
    {"name": "tmax", "label": "时窗终点", "type": "number", "unit": "s", "default": 1.0},
    {"name": "split_by", "label": "输出拆分", "type": "select", "default": "none", "options": [{"value": "none", "label": "合并 (一个数据集含所有 condition)"}, {"value": "condition", "label": "按 condition 拆分"}]}
  ],
  "backend": {
    "module": "app.engine.analysis.epoching",
    "function": "run_epoch_segment",
    "save_descriptor": "epo",
    "output_kind": "fif",
    "supports_batch": true,
    "interactive": false
  },
  "save": {
    "step_label": "epoch",
    "auto_tags": ["step:epoch", "type:epochs"],
    "dynamic_tags_when_split": ["cond:{condition}"],
    "name_template_default": "{subject}_{task}_{node_title}",
    "name_template_default_split": "{subject}_{task}_{condition}_{node_title}",
    "split_supported": true,
    "data_type": "epochs"
  },
  "compute_cost": "cheap",
  "output_footprint": "medium",
  "ui": {"color": "#059669", "default_size": [190, 110], "preview_type": "epochs"}
}
