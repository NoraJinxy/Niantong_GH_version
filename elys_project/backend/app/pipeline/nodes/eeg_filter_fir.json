{
  "schema_version": "2.0",
  "type": "eeg/filter/fir",
  "title": "FIR Filter",
  "category": "preprocessing",
  "phase": "phase1",
  "description": "FIR 滤波，输出写入 derivatives，不改写 fifdata。",
  "tags": ["filter", "fir", "preprocess"],
  "inputs": [
    {"name": "input", "type": "eeg_data", "label": "EEG Data", "required": true, "cardinality": "one_or_many"}
  ],
  "outputs": [
    {"name": "output", "type": "eeg_data", "label": "Filtered EEG", "cardinality": "same_as_input"}
  ],
  "properties": [
    {"name": "filter_mode", "label": "Filter Mode", "type": "select", "default": "bandpass", "required": true, "options": [{"value": "bandpass", "label": "Bandpass"}, {"value": "lowpass", "label": "Lowpass"}, {"value": "highpass", "label": "Highpass"}]},
    {"name": "l_freq", "label": "Low Cutoff", "type": "number", "unit": "Hz", "default": 0.5, "min": 0},
    {"name": "h_freq", "label": "High Cutoff", "type": "number", "unit": "Hz", "default": 30.0, "min": 0},
    {"name": "phase", "label": "Phase", "type": "select", "default": "zero", "options": [{"value": "zero", "label": "Zero phase"}, {"value": "minimum", "label": "Minimum phase"}]}
  ],
  "backend": {
    "module": "app.engine.preprocess.filters",
    "function": "run_fir_filter",
    "save_descriptor": "filt",
    "output_kind": "fif",
    "supports_batch": true,
    "interactive": false
  },
  "save": {
    "step_label": "fir",
    "auto_tags": ["step:fir", "type:raw"],
    "name_template_default": "{subject}_{task}_{node_title}",
    "split_supported": false,
    "data_type": "raw"
  },
  "cache": {"enabled": true, "strategy": "content_hash"},
  "ui": {"color": "#00A5A8", "default_size": [190, 100], "preview_type": "time_series"}
}
