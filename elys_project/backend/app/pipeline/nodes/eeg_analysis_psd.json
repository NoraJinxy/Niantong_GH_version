{
  "schema_version": "2.0",
  "type": "eeg/analysis/psd",
  "title": "Power Spectral Density (PSD)",
  "category": "analysis",
  "phase": "phase1",
  "description": "对 Epochs 做功率谱密度估计（Welch），输出各频段平均功率。",
  "tags": ["psd", "spectrum", "welch", "frequency", "analysis"],
  "inputs": [
    {"name": "input", "type": "epochs", "label": "Epochs", "required": true, "cardinality": "one_or_many"}
  ],
  "outputs": [
    {"name": "output", "type": "psd", "label": "PSD", "cardinality": "same_as_input"}
  ],
  "properties": [
    {"name": "condition", "label": "Condition", "type": "event_select", "default": "", "required": true, "description": "从上游 Epoch 勾选的 condition 里选；每个 condition 单独算一条功率谱。"},
    {"name": "fmin", "label": "最低频率", "type": "number", "unit": "Hz", "default": 1, "min": 0, "step": 0.5},
    {"name": "fmax", "label": "最高频率", "type": "number", "unit": "Hz", "default": 40, "min": 1, "step": 1},
    {"name": "method", "label": "方法", "type": "select", "default": "welch", "advanced": true, "options": [{"value": "welch", "label": "Welch"}, {"value": "multitaper", "label": "Multitaper"}]}
  ],
  "backend": {
    "module": "app.engine.analysis.psd",
    "function": "run_psd",
    "save_descriptor": "psd",
    "output_kind": "npz",
    "supports_batch": true,
    "interactive": false
  },
  "save": {
    "step_label": "psd",
    "auto_tags": ["step:psd", "type:psd"],
    "dynamic_tags_always": ["cond:{condition}"],
    "name_template_default": "{subject}_{task}_{condition}_{node_title}",
    "split_supported": false,
    "always_per_condition": true,
    "data_type": "psd"
  },
  "compute_cost": "low",
  "output_footprint": "small",
  "ui": {"color": "#2563EB", "default_size": [200, 110], "preview_type": "psd"}
}
