{
  "schema_version": "2.0",
  "type": "eeg/ica/apply",
  "title": "Apply ICA",
  "category": "ica",
  "phase": "phase1",
  "description": "应用人工确认的 ICA 剔除成分。",
  "tags": ["ica", "artifact"],
  "inputs": [
    {"name": "input", "type": "eeg_data", "label": "EEG Data", "required": true, "cardinality": "one_or_many"},
    {"name": "ica_matrix", "type": "ica_matrix", "label": "ICA Matrix", "required": true, "cardinality": "same_as_input"}
  ],
  "outputs": [
    {"name": "output", "type": "eeg_data", "label": "Cleaned EEG", "cardinality": "same_as_input"}
  ],
  "properties": [
    {"name": "excluded_components", "label": "Excluded Components", "type": "text", "default": "", "required": true},
    {"name": "decision_version", "label": "Decision Version", "type": "integer", "default": 1}
  ],
  "backend": {
    "module": "app.engine.ica.apply",
    "function": "run_apply_ica",
    "save_descriptor": "clean",
    "output_kind": "fif",
    "supports_batch": true,
    "interactive": true
  },
  "save": {
    "step_label": "ica-apply",
    "auto_tags": ["step:ica-apply", "type:raw"],
    "name_template_default": "{subject}_{task}_{node_title}",
    "split_supported": false,
    "data_type": "raw"
  },
  "cache": {"enabled": true, "strategy": "content_hash"},
  "ui": {"color": "#8B5CF6", "default_size": [190, 100], "preview_type": "ica"}
}
