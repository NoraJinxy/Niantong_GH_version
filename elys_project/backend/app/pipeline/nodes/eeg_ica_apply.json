{
  "schema_version": "2.0",
  "type": "eeg/ica/apply",
  "title": "Apply ICA",
  "category": "ica",
  "phase": "phase1",
  "description": "应用人工确认的 ICA 剔除成分。",
  "tags": ["ica", "artifact"],
  "inputs": [
    {"name": "input", "type": "eeg_data", "label": "EEG", "required": true, "cardinality": "one_or_many"},
    {"name": "ica_matrix", "type": "ica_matrix", "label": "ICA", "required": true, "cardinality": "same_as_input"}
  ],
  "outputs": [
    {"name": "output", "type": "eeg_data", "label": "EEG", "cardinality": "same_as_input"}
  ],
  "properties": [
    {
      "name": "excluded_components",
      "label": "剔除成分",
      "type": "text",
      "default": "",
      "required": false,
      "advanced": true,
      "description": "仅用于显示历史审核摘要；正式运行必须通过「ICA 成分审核」页提交本次运行的决策，避免 ICA 矩阵变化后复用旧编号。"
    },
    {"name": "decision_version", "label": "决策版本", "type": "integer", "default": 1, "advanced": true}
  ],
  "backend": {
    "module": "app.engine.ica.apply",
    "function": "run_apply_ica",
    "save_descriptor": "clean",
    "output_kind": "fif",
    "supports_batch": true,
    "interactive": true
  },
  "save": {
    "step_label": "ica-apply",
    "auto_tags": ["step:ica-apply", "type:raw"],
    "name_template_default": "{subject}_{task}_{node_title}",
    "split_supported": false,
    "data_type": "raw"
  },
  "compute_cost": "moderate",
  "output_footprint": "large",
  "ui": {"color": "#8B5CF6", "default_size": [190, 100], "preview_type": "ica"}
}
